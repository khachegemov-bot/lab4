# Скопируйте этот файл в .env и укажите свои значения.
# Файл .env содержит пароль и НЕ должен попадать в git (он в .gitignore).
DB_URL=jdbc:postgresql://localhost:5432/city_reports
DB_USERNAME=city_app
DB_PASSWORD=change_me

# Пользователь только для чтения (отчёты, pgAdmin); приложение его не использует.
READONLY_DB_USERNAME=city_readonly
READONLY_DB_PASSWORD=change_me
